{$API_HOSTNAME} {
	tls me@wwr.icu
	encode gzip

	handle /api/open/* {
		uri strip_prefix /api
		reverse_proxy {
			to http://basic-service:8000
		}
	}

	handle /api/admin/* {
		uri strip_prefix /api
		reverse_proxy {
			to http://basic-service:8000
		}
	}

	log {
		format json
		output file /var/log/caddy-api.log {
			roll_size 10MiB
			roll_keep 10
		}
	}
}

{$DIRECT_HOSTNAME} {
	tls me@wwr.icu
	encode gzip

	handle /gp {
		reverse_proxy {
			to http://v2ray:8443
			header_up X-Real-IP {remote_host}
		}
	}

	@bp path /bp /bp/*
	handle @bp {
		reverse_proxy {
			to http://bad_proxy:8443
			flush_interval -1
		}
	}

	@btp path /btp /btp/*
	handle @btp {
		reverse_proxy {
			to http://bad_proxy:8444
			flush_interval -1
		}
	}

	handle {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy {
			to https://{$ADMIN_HOSTNAME}
			header_up Host {upstream_hostport}
		}
	}

	log {
		format json
		output file /var/log/caddy-direct.log {
			roll_size 10MiB
			roll_keep 10
		}
	}
}

{$RESOURCE_HOSTNAME} {
	tls me@wwr.icu
	encode gzip

	handle /image/* {
		reverse_proxy {
			to http://basic-service:8000
		}
	}

	log {
		format json
		output file /var/log/caddy-resource.log {
			roll_size 10MiB
			roll_keep 10
		}
	}
}
