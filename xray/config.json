{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "tag": "ref-ws",
      "port": 18443,
      "protocol": "vless",
      "settings": {
        "clients": [ { "id": "{PROXY_SECRET}" } ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "certificates": [
            { "certificateFile": "/etc/xray/ref.crt", "keyFile": "/etc/xray/ref.key" }
          ],
          "alpn": [ "http/1.1" ]
        },
        "wsSettings": { "path": "/xws" }
      }
    }
  ],
  "outbounds": [ { "protocol": "freedom", "tag": "direct" } ]
}
